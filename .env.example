# =====================================================================
# Paperless-ngx on WSL2 — Docker Compose Environment Configuration
# Copy this file to .env and update the dummy values before starting.
# Command: cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# WSL2 Host User Mapping
# ---------------------------------------------------------------------
# Run these commands in your WSL2 terminal to get your exact IDs:
#   id -u
#   id -g
# Set the outputs below (Default WSL2 user is usually 1000):
USERMAP_UID=1000
USERMAP_GID=1000

# ---------------------------------------------------------------------
# Paperless-ngx Application Configuration
# ---------------------------------------------------------------------

# Timezone used by Paperless-ngx for document dates and application display
PAPERLESS_TIME_ZONE=America/New_York

# DUMMY SECRET KEY - REPLACE BEFORE DEPLOYMENT
# Generate a unique 64-character key by running this command in your terminal:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PAPERLESS_SECRET_KEY=DUMMY_SECRET_KEY_REPLACE_WITH_YOUR_GENERATED_64_CHAR_HEX_KEY

# Primary OCR language
# Common language codes: eng (English), deu (German), fra (French), spa (Spanish)
PAPERLESS_OCR_LANGUAGE=eng

# Base URL used to access Paperless-ngx (No trailing slash)
# Use http://127.0.0.1:8000 or http://localhost:8000 for local WSL2 access.
PAPERLESS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------
# PostgreSQL Database Configuration
# ---------------------------------------------------------------------

PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=db
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless

# DUMMY DATABASE PASSWORDS - REPLACE BEFORE DEPLOYMENT
# Both PAPERLESS_DBPASS and POSTGRES_PASSWORD MUST have the exact same value!
PAPERLESS_DBPASS=DUMMY_STRONG_DATABASE_PASSWORD_CHANGE_ME
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=DUMMY_STRONG_DATABASE_PASSWORD_CHANGE_ME

# ---------------------------------------------------------------------
# Valkey Message Broker Configuration
# ---------------------------------------------------------------------

# The hostname "broker" must match the Compose service name in docker-compose.yml
PAPERLESS_REDIS=redis://broker:6379

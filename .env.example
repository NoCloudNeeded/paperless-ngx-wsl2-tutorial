# --- WSL2 Host User Mapping ---
# Run 'id -u' and 'id -g' in your WSL2 terminal to find your IDs
USERMAP_UID=1000
USERMAP_GID=1000

# --- Paperless-ngx Configuration ---
PAPERLESS_TIME_ZONE=America/New_York
PAPERLESS_OCR_LANGUAGE=eng

# Generate a real 64-char key: python3 -c "import secrets; print(secrets.token_hex(32))"
PAPERLESS_SECRET_KEY=REPLACE_WITH_YOUR_GENERATED_64_CHARACTER_KEY

# --- PostgreSQL Database ---
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=db
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=REPLACE_WITH_A_STRONG_PASSWORD

POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# --- Valkey Message Broker (Redis-protocol compatible) ---
PAPERLESS_REDIS=redis://broker:6379

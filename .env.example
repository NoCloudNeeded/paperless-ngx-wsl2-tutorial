# =====================================================================
# Paperless-ngx on WSL2 — Docker Compose environment configuration
# Copy this file to .env and replace every REPLACE_WITH_* value.
# =====================================================================

# WSL2 host user mapping
# Run these commands first and replace the values below:
#   id -u
#   id -g
USERMAP_UID=1000
USERMAP_GID=1000

# ---------------------------------------------------------------------
# Paperless-ngx configuration
# ---------------------------------------------------------------------

# Timezone used by Paperless-ngx
PAPERLESS_TIME_ZONE=America/New_York

# Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PAPERLESS_SECRET_KEY=REPLACE_WITH_YOUR_GENERATED_64_CHARACTER_KEY

# Primary OCR language
# Common values: eng, deu, fra, spa, ita, nld
PAPERLESS_OCR_LANGUAGE=eng

# URL used to access Paperless-ngx
# Do not add a trailing slash.
PAPERLESS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------
# PostgreSQL database
# ---------------------------------------------------------------------

PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=db
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless

# Must exactly match POSTGRES_PASSWORD below.
PAPERLESS_DBPASS=REPLACE_WITH_A_STRONG_PASSWORD

POSTGRES_DB=paperless
POSTGRES_USER=paperless

# Must exactly match PAPERLESS_DBPASS above.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ---------------------------------------------------------------------
# Valkey message broker
# ---------------------------------------------------------------------

# The hostname "broker" must match the Compose service name.
PAPERLESS_REDIS=redis://broker:6379

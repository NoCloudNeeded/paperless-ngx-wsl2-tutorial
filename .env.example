# Host User ID mapping (run 'id -u' and 'id -g' to match your host)
USERMAP_UID=1000
USERMAP_GID=1000

# Security Key (Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
PAPERLESS_SECRET_KEY=change-this-to-a-secure-random-64-char-string

# Public URL
PAPERLESS_URL=http://localhost:8000

# Timezone & OCR
PAPERLESS_TIME_ZONE=America/New_York
PAPERLESS_OCR_LANGUAGE=eng

# Ignore everything by default
*

# Allow repository configuration and documentation
!.gitignore
!README.md
!docs/
!docs/**
!docker-compose.yml
!.env.example

# Always protect real credentials and data directories
.env
**/.env
data/
media/
consume/
export/
pgdata/
redisdata/
*.wav
*.mp4
*.log

# Protect secrets and keys anywhere in the repository
*.key
*.pem
*.p12
*.pfx
secrets*

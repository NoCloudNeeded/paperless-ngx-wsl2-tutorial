# =====================================================================
# Paperless-ngx on WSL2 — Git Ignore Policy
# Strategy: Block everything by default, explicitly whitelist safe repository files.
# =====================================================================

# 1. Ignore everything by default
*

# 2. Whitelist essential tracking files and documentation
!.gitignore
!.env.example
!README.md
!docker-compose.yml
!docs/
!docs/**

# 3. Protect local environment variables and database dumps
.env
**/.env
*.sql

# 4. Protect persistent storage and volume directories
data/
media/
consume/
export/
pgdata/
redisdata/
valkeydata/

# 5. Protect media, generated assets, and runtime logs
*.wav
*.mp4
*.log

# 6. Protect SSL/TLS keys, certificates, and secret files
*.key
*.pem
*.p12
*.pfx
secrets*
